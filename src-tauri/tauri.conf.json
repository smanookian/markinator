{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "markinator",
  "version": "0.1.2",
  "identifier": "com.stevinator.markinator",
  "mainBinaryName": "markinator",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Untitled - markinator",
        "width": 900,
        "height": 700,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
